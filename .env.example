# Momentum environment settings
# Export values into the host environment. Do not commit real credentials.

# Storage: local Azurite by default
MOMENTUM_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Authentication: none | entra | oauth
# --dev and the Development hosting environment disable authentication.
# MOMENTUM_AUTH_MODE=entra

# Entra ID
# MOMENTUM_AUTH_ENTRA_INSTANCE=https://login.microsoftonline.com/
# MOMENTUM_AUTH_ENTRA_TENANT_ID=
# MOMENTUM_AUTH_ENTRA_CLIENT_ID=
# MOMENTUM_AUTH_ENTRA_CLIENT_SECRET=
# MOMENTUM_AUTH_ENTRA_AUDIENCE=api://<client-id>
# MOMENTUM_AUTH_ENTRA_REDIRECT_URI=http://localhost:5100/oauth/callback

# Generic OAuth / OIDC
# MOMENTUM_AUTH_OAUTH_ISSUER=https://your-issuer.example
# MOMENTUM_AUTH_OAUTH_CLIENT_ID=
# MOMENTUM_AUTH_OAUTH_CLIENT_SECRET=
# MOMENTUM_AUTH_OAUTH_AUDIENCE=
# MOMENTUM_AUTH_OAUTH_SCOPES=openid email profile
# MOMENTUM_AUTH_OAUTH_EMAIL_CLAIM=email
# MOMENTUM_AUTH_OAUTH_REDIRECT_URI=http://localhost:5100/oauth/callback

# Optional MCP OAuth clients; clientName and clientSecret are optional.
# MOMENTUM_AUTH_PRE_REGISTERED_CLIENTS=[{"clientId":"example","redirect_uris":["cursor://app/callback"]}]

# Set a unique secret for deployment.
# MOMENTUM_SESSION_SECRET=replace-with-a-long-random-secret
